# --- Required at runtime (never editable from the UI) ---
DATABASE_URL=postgres://user:pass@host/db
RESEND_API_KEY=xxxx
# Bearer token the router's quota-push script must send to /api/ingest, and the
# one the scheduler sends to /api/cron/tick (see README, "Scheduled jobs").
CRON_SECRET=some-random-string

# Database TLS. Leave all unset for Neon (public CA) or a local database.
# Supabase's pooler uses a private CA; the keyword "supabase" selects the bundled root cert:
DATABASE_SSL_CA=supabase
# DATABASE_SSL_CA also accepts any other PEM certificate inline ("\n"-escaped is fine).
# Last resort: DATABASE_SSL=no-verify encrypts without verifying the server.
# DATABASE_SSL=no-verify

# Sender address for alert emails. Must be on a domain verified in Resend.
# "onboarding@resend.dev" works for testing but can only deliver to the
# email address that owns the Resend account.
ALERT_EMAIL_FROM=Quota Monitor <onboarding@resend.dev>

# Optional. Public URL of this dashboard. When set, the alert email carries an
# "Open the dashboard" button pointing at it and password-reset links use it;
# when unset the button is omitted and reset links use the requesting address.
# APP_URL=https://monitor.example.com

# Optional. Bearer token a Prometheus scraper presents to GET /api/metrics.
# Unset, the endpoint still works for a signed-in browser but not for a scraper.
# METRICS_TOKEN=some-other-random-string

# Optional. Cloudflare Turnstile keys (dash.cloudflare.com > Turnstile). With both
# set, sign in, forgot/reset password and the share link ask for the bot check;
# with either unset the check is off. Read at runtime, so no rebuild is needed.
# Add every hostname the dashboard is opened on (including localhost for dev)
# to the widget's allowed hostnames in Cloudflare.
# TURNSTILE_SITE_KEY=0x4AAAAAAA...
# TURNSTILE_SECRET_KEY=0x4AAAAAAA...

# --- Everything else lives in the database ---
# Login: schema.sql seeds the account bilalnasr / admin123. Change the password
# on /settings. No signing secret is needed: session tokens are random and
# stored hashed in the auth_sessions table.
# Quota, window, timezone, alert address, WAN interface name and the pause
# switch are seeded by schema.sql and edited on the /settings page. They are
# deliberately NOT environment variables, so changing them needs no restart.
